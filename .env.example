# Winter Arc – Namdapha (IIT Madras BS) Environment Configuration
# Copy this file to .env and fill in your values for production deployment

# 1. Supabase Project Credentials (from Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Configurable Eligible Email Domains (comma-separated, lowercase)
# Only verified Google accounts with these domains can enter the platform
VITE_ALLOWED_EMAIL_DOMAINS=ds.study.iitm.ac.in,es.study.iitm.ac.in,study.iitm.ac.in

# 3. Official Challenge Timezone (Do not alter from Asia/Kolkata)
VITE_CHALLENGE_TIMEZONE=Asia/Kolkata
